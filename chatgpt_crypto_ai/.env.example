# OpenAI 配置
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o
OPENAI_TIMEOUT=30

# 数据库配置
DATABASE_URL=postgresql://coingpt:password@localhost:5432/coingpt

# Flask 配置
SECRET_KEY=your_secret_key
DEBUG=False

# 交易配置（系统级，仅用于测试，生产环境用户自己配置）
